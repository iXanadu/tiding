# engram systemd service
#
# This is a reference template. The install script (scripts/install.sh)
# generates a service file with correct paths automatically.
#
# Manual install:
#   sudo cp systemd/engram.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now engram

[Unit]
Description=engram FastAPI service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/opt/srv/engram
ExecStart=/home/YOUR_USERNAME/.pyenv/versions/engram-3.12/bin/python -m server
Restart=always
RestartSec=5
Environment=PATH=/home/YOUR_USERNAME/.pyenv/versions/engram-3.12/bin:/usr/local/bin:/usr/bin:/bin
# Embed model is pinned + fully cached; skip the online HF metadata
# revalidation at boot (avoids a startup race that crash-loops the service).
# Flip OFF only for a deliberate embed-model change needing a re-download.
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1

[Install]
WantedBy=multi-user.target
