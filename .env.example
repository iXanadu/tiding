# engram configuration
# Copy to .env and adjust as needed
#
# If using docker-compose.yml, these defaults work without edits.
# The default credentials (engram/engram) match the docker-compose.yml settings.

# PostgreSQL
ENGRAM_DB_HOST=localhost
ENGRAM_DB_PORT=5432
ENGRAM_DB_NAME=engram
ENGRAM_DB_USER=engram
ENGRAM_DB_PASSWORD=engram

# Embeddings (in-process via sentence-transformers — no external service)
# Model downloads from HuggingFace on first run (~270MB, cached in ~/.cache/huggingface)
ENGRAM_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Server
ENGRAM_HOST=0.0.0.0
ENGRAM_PORT=8920
ENGRAM_LOG_LEVEL=info

# Optional API token — if set, all requests (except /health) require:
#   Authorization: Bearer <token>
# Leave empty for no authentication (secure via network/firewall instead).
# ENGRAM_API_TOKEN=

# Search tuning
ENGRAM_VECTOR_THRESHOLD=0.35
ENGRAM_TRIGRAM_WEIGHT=0.15
ENGRAM_TRIGRAM_THRESHOLD=0.1
