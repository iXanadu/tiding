# engram configuration
# Copy to .env and adjust as needed
#
# If using docker-compose.yml, these defaults work without edits.
# The default credentials (engram/engram) match the docker-compose.yml settings.

# PostgreSQL
ENGRAM_DB_HOST=localhost
ENGRAM_DB_PORT=5432
ENGRAM_DB_NAME=engram
ENGRAM_DB_USER=engram
ENGRAM_DB_PASSWORD=engram

# Embeddings (in-process via sentence-transformers — no external service)
# Model downloads from HuggingFace on first run (~270MB, cached in ~/.cache/huggingface)
ENGRAM_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Server — SECURE BY DEFAULT: loopback bind, no auth needed for local use.
# A non-loopback bind (0.0.0.0) with NO auth REFUSES TO START unless you set
# ENGRAM_ALLOW_INSECURE_BIND=true (private overlay net only). See the security
# posture in docs/getting-started.md before exposing this anywhere.
ENGRAM_HOST=127.0.0.1
ENGRAM_PORT=8920
ENGRAM_LOG_LEVEL=info

# To bind beyond loopback, pick ONE:
#   (A) real auth (recommended for any network):
#         ENGRAM_REQUIRE_AUTH=true      # then mint principal tokens
#   (B) trusted private overlay (Tailscale/WireGuard), tokenless, deliberate:
#         ENGRAM_HOST=0.0.0.0
#         ENGRAM_ALLOW_INSECURE_BIND=true
# When binding non-loopback, add your hostname / Tailscale MagicDNS name:
#   ENGRAM_TRUSTED_HOSTS=localhost,127.0.0.1,[::1],my-box.tailXXXX.ts.net

# Legacy single-token auth (principals are the modern path). Empty = no legacy
# token. This does NOT bypass the secure-bind guard above.
# ENGRAM_API_TOKEN=
# ENGRAM_REQUIRE_AUTH=false

# Search tuning
ENGRAM_VECTOR_THRESHOLD=0.35
ENGRAM_TRIGRAM_WEIGHT=0.15
ENGRAM_TRIGRAM_THRESHOLD=0.1
